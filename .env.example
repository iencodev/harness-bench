# Copy to .env (gitignored). scripts/bench.sh loads it.

# Claude Max subscription token: run `claude setup-token` and paste the result.
# Harbor's Claude Code adapter uses it instead of an API key, so runs count
# against the Max plan's 5-hour and weekly limits.
CLAUDE_CODE_OAUTH_TOKEN=

# Kiro API key for headless mode (Kiro settings, API keys). Requires a Pro or
# higher plan; on an organisation-managed subscription an admin must enable keys.
KIRO_API_KEY=

# Optional knobs (defaults in scripts/bench.sh):
# MODEL=opus-5.5       # opus-5.5 | sonnet-5.5 | haiku-5.5 | fable-5.1 (Claude only); scripts/bench.sh models
# EFFORT=high          # same reasoning effort for both harnesses; unset = each tool's default
# K=3                  # attempts per task (safety suite defaults to 5)
# N=2                  # concurrent trials; raise on a bigger host
# CLAUDE_VERSION=2.1.316

# Decision-quality judge (scripts/bench.sh judge <suite>). Run at least two,
# one of them not from Anthropic, and compare agreement in the report.
# JUDGE_AGENT=codex
# JUDGE_MODEL=
# JUDGE_SAMPLE=40      # judge a stratified subset to cap cost
# OPENAI_API_KEY=      # if the judge agent needs it
